{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information including roles and basic profile data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's full name." },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"], "description": "User's role in the system." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL to the user's profile photo." },
        "createdAt": { "type": "number", "description": "Timestamp when the user was created." }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "DoctorProfile": {
      "title": "Doctor Profile",
      "description": "Extended profile information for doctors.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "rating": { "type": "number" },
        "availability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": { "type": "string" },
              "startTime": { "type": "string" },
              "endTime": { "type": "string" },
              "isAvailable": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["uid", "specialization", "bio", "rating"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Details of a medical appointment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "patientName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "slot": { "type": "string" },
        "status": { "type": "string", "enum": ["booked", "cancelled", "completed"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "patientId", "doctorId", "date", "slot", "status", "createdAt"]
    },
    "KnowledgeItem": {
      "title": "Knowledge Item",
      "description": "Medical knowledge base items extracted from markdown files.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/doctors/{doctorId}": {
      "schema": "DoctorProfile",
      "description": "Doctor-specific profile data."
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Appointment records."
    },
    "/knowledge/{itemId}": {
      "schema": "KnowledgeItem",
      "description": "Knowledge base entries."
    }
  }
}
